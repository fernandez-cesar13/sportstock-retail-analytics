model Model
	culture: es-ES
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: es-ES
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DimCalendario","DimCategoria","DimProducto","DimTienda","FactVentas","FactStock","_Medidas","RutaDatos"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

ref table DimCalendario
ref table DimCategoria
ref table DimProducto
ref table DimTienda
ref table FactVentas
ref table FactStock
ref table _Medidas

ref cultureInfo es-ES

