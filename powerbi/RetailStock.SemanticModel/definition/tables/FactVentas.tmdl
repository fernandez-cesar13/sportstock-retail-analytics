/// Ventas diarias agregadas por fecha, tienda y producto (grano del hecho).
table FactVentas

	column venta_id
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: venta_id

	column fecha
		dataType: dateTime
		isHidden
		formatString: dd/mm/yyyy
		summarizeBy: none
		sourceColumn: fecha

	column tienda_id
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: tienda_id

	column producto_id
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: producto_id

	column unidades
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: unidades

	column importe
		dataType: double
		formatString: #,##0.00
		summarizeBy: sum
		sourceColumn: importe

	column coste
		dataType: double
		formatString: #,##0.00
		summarizeBy: sum
		sourceColumn: coste

	partition FactVentas = m
		mode: import
		source = ```
				let
					// Lee el CSV en UTF-8 (65001) desde la carpeta del parámetro RutaDatos
					Origen = Csv.Document(File.Contents(RutaDatos & "ventas.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
					// Tipos con cultura en-US porque el CSV usa punto decimal y fechas ISO
					Tipos = Table.TransformColumnTypes(Encabezados, {{"venta_id", Int64.Type}, {"fecha", type date}, {"tienda_id", Int64.Type}, {"producto_id", Int64.Type}, {"unidades", Int64.Type}, {"importe", type number}, {"coste", type number}}, "en-US")
				in
					Tipos
				```
